# ====================================================================
#  VARIABLES DE ENTORNO (Resend)
# --------------------------------------------------------------------
#  En Vercel NO se usa este archivo: las variables se crean en
#  Settings → Environment Variables (Production y Preview).
#
#  Para probar en tu computador con `npx vercel dev`:
#  copia este archivo como .env.local y completa los valores.
# ====================================================================

# 1. API key de Resend → https://resend.com/api-keys
#    Permiso "Sending access". Empieza por "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2. Correo que RECIBE los mensajes.
#    En pruebas debe ser el mismo correo con el que creaste la cuenta
#    de Resend (limitación de onboarding@resend.dev).
DESTINO_EMAIL=tu-correo@gmail.com

# 3. Correo REMITENTE.
#    Sin dominio verificado, Resend solo permite este:
REMITENTE_EMAIL=onboarding@resend.dev
